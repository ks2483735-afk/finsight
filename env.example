# ============================================================================
# FinSight — environment configuration template
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in only the keys you want to use.
# FinSight is BYOK (Bring Your Own Keys): every provider is optional and the
# app stays useful without any key (mock/demo + public data mode).
#
# NEVER commit real API keys. `.env.local` is git-ignored.
# Keys can also be entered at runtime in Settings → Providers, where they are
# stored in the local SQLite database and never exposed to browser code.
# ============================================================================

# --- Local database ---------------------------------------------------------
# Path to the local SQLite database (relative to the project root).
FINSIGHT_DB_PATH=./data/finsight.db

# --- AI providers (used by the AI Router) -----------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://aimlapi.com
AIMLAPI_API_KEY=
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1

# https://bazaarlink (OpenAI-compatible)
BAZAARLINK_API_KEY=
BAZAARLINK_BASE_URL=

# --- Market data providers --------------------------------------------------
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# https://finnhub.io/register
FINNHUB_API_KEY=

# --- News providers ---------------------------------------------------------
# https://newsapi.org/register
NEWSAPI_API_KEY=

# --- Notes ------------------------------------------------------------------
# * All keys are optional. Without keys FinSight runs in demo mode and labels
#   mock data clearly in the UI.
# * Server-side keys are never sent to the browser. See docs/security.md.
# * Rotate keys by revoking them at the provider and issuing a new one.
